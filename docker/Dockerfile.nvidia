FROM python:3.11-bookworm

# Install ffmpeg and libzimg2
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg libzimg2 && \
    rm -rf /var/lib/apt/lists/*

# NVIDIA Container Toolkit integration environment variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

WORKDIR /app

# Install Python dependencies first (better layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bring in the rest of the project
COPY . .

# Install core package (editable)
RUN pip install --no-cache-dir -e .

# Make entrypoint executable
RUN chmod +x entrypoint.sh

CMD ["./entrypoint.sh"]
